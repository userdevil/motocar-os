<?xml version="1.0" encoding="utf-8"?>
<!-- MotoCar OS: Landscape Layout (Optimized for Bike Horizontal Handlebar Mount & Car Dash) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Hardware Video Surface (Widescreen 16:9 for Wide Navigation) -->
    <SurfaceView
        android:id="@+id/projection_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 2. Waiting Overlay (Displayed when no phone connected) -->
    <LinearLayout
        android:id="@+id/waiting_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6050811"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MotoCar OS"
            android:textColor="#3B82F6"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bike &amp; Car Smart Display • Landscape Mount"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/connection_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connecting_phone"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plug in USB cable or connect via 2.4GHz / 5GHz Wi-Fi / Bluetooth"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <!-- 3. Top Status Bar Overlay (Widescreen) -->
    <LinearLayout
        android:id="@+id/status_bar_overlay"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#B3000000"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_orientation_mode"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="BIKE / CAR: LANDSCAPE (TAP TO ROTATE)"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#1E293B"
            android:paddingHorizontal="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Telemetry Indicators -->
        <TextView
            android:id="@+id/txt_status_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Helmet / Audio: Connected"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/txt_status_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5GHz Wi-Fi: Active"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/txt_phone_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Battery: 88%"
            android:textColor="#FBBF24"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
