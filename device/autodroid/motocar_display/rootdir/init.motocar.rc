#
# Copyright (C) 2026 The Android Open Source Project
# MotoCar OS Init Script for Head Unit
#

on early-init
    # Set high-performance CPU governor for sub-15ms video decoding latency
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor performance

on boot
    # Configure USB Open Accessory (AOA 2.0)
    setprop sys.usb.configfs 1
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000

    # Ensure uinput permissions for touch digitizer event return
    chmod 0660 /dev/uinput
    chown system input /dev/uinput

    # Ensure USB accessory node permissions
    chmod 0660 /dev/usb_accessory
    chown system system /dev/usb_accessory

    # 5GHz Wi-Fi High-Throughput Optimization
    setprop wifi.interface wlan0
    setprop wifi.direct.interface p2p-dev-wlan0

on property:sys.boot_completed=1
    # Start the native projection daemon once framework is ready
    start motocar_projection

service motocar_projection /vendor/bin/motocar_projection_service
    class main
    user system
    group system audio input inet net_raw net_admin
    capabilities NET_ADMIN NET_BIND_SERVICE
    seclabel u:r:motocar_projection:s0
    oneshot
